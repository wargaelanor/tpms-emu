<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A16">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        app:tabIndicatorColor="#69F0AE"
        app:tabSelectedTextColor="#69F0AE"
        app:tabTextColor="#9E9E9E"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Главная" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== ГЛАВНАЯ ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Статус + батарея -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status"
                                android:textColor="#9E9E9E"
                                android:textSize="12sp"
                                android:textAllCaps="true"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvConnectionState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/device_not_connected"
                                android:textColor="#FF5252"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <com.tpms.nrf52840.BatteryView
                            android:id="@+id/batteryIcon"
                            android:layout_width="88dp"
                            android:layout_height="38dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Датчики -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sensors"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:id="@+id/sensorsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===================== НАСТРОЙКИ ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Emulator -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emulator"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <Button
                            android:id="@+id/btnBurst"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/burst"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:textColorHint="#9E9E9E">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etInterval"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/interval"
                                    android:inputType="number"
                                    android:text="300"
                                    android:textColor="#E0E0E0" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColorHint="#9E9E9E">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPackets"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/packets"
                                    android:inputType="number"
                                    android:text="2"
                                    android:textColor="#E0E0E0" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnSaveAutoTx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/save"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Sniffer -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sniffer"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnSniffToggle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/start"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btnSniffApply"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/apply" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSniffResults"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Frequency -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/freq"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <RadioGroup
                            android:id="@+id/rgFreq"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb315"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="315 МГц"
                                android:checked="true"
                                android:textColor="#E0E0E0" />

                            <RadioButton
                                android:id="@+id/rb433"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="433 МГц"
                                android:textColor="#E0E0E0" />
                        </RadioGroup>

                        <Button
                            android:id="@+id/btnSaveFreq"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/save"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Battery -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:textColorHint="#9E9E9E"
                                android:hint="Источник: 255=VDDH или 14..21">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etBattPin"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="255"
                                    android:textColor="#E0E0E0" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Button
                                android:id="@+id/btnSaveBattPin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Пин" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:textColorHint="#9E9E9E"
                                android:hint="Реальное напряжение (мВ)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etBattCalMv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="3540"
                                    android:textColor="#E0E0E0" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Button
                                android:id="@+id/btnBattCal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Калибр." />

                            <Button
                                android:id="@+id/btnReset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Сброс"
                                android:textColor="#E57373" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBattDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Расчёт ресурса АКБ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Расчёт ресурса АКБ (примерно)"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:textColorHint="#9E9E9E"
                                android:hint="Ёмкость, мАч">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etCapacity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="500"
                                    android:textColor="#E0E0E0" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Button
                                android:id="@+id/btnCalcBattLife"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Рассчитать" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBattLifeResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#69F0AE"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Базу держат BLE-анонс (~1 мА) и CC1101 в IDLE (~1.5 мА) — поэтому интервал передач почти не влияет на ресурс."
                            android:textColor="#9E9E9E"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- License -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/license"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColorHint="#9E9E9E">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLicense"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/license_key"
                                android:maxLength="8"
                                android:textColor="#E0E0E0" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnActivate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activate"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvLicense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Пробный период"
                            android:textColor="#FFD740"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Log -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/log"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:textAllCaps="true"
                            android:layout_marginBottom="10dp" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:background="#0A0A16"
                            android:padding="8dp"
                            android:nestedScrollingEnabled="true">

                            <TextView
                                android:id="@+id/tvLog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#9E9E9E"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:lineSpacingMultiplier="1.2" />
                        </ScrollView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
